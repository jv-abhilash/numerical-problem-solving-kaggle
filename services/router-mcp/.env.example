# MCP Router Service Environment Variables

# Optional API Key for authentication
# Leave empty for no authentication
MCP_API_KEY=

# Model configuration
ROUTER_MODEL_ID=Qwen/Qwen2.5-Math-7B-Instruct
MAX_NEW_TOKENS=32
TEMPERATURE=0.0

# GPU configuration
CUDA_VISIBLE_DEVICES=0

# Model cache directory (inside container)
TRANSFORMERS_CACHE=/app/models
HF_HOME=/app/models

# Hugging Face token (if needed for gated models)
# HF_TOKEN=your_token_here
